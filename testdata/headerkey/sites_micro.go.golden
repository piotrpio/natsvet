package headerkey

import (
	"github.com/nats-io/nats.go/micro"
)

func microRange(req micro.Request) {
	for k := range req.Headers() {
		if k == micro.ErrorHeader { // want `header key "nats-service-error" does not match "Nats-Service-Error"; nats.go header lookups are case-sensitive`
			continue
		}
	}
	_ = micro.Headers{micro.ErrorCodeHeader: {"500"}} // want `header key "NATS-SERVICE-ERROR-CODE" does not match "Nats-Service-Error-Code"; nats.go header lookups are case-sensitive`
}
